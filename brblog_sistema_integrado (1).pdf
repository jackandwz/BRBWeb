      function inicializarBaseConhecimento() {
          localStorage.setItem('brblog_base_conhecimento', JSON.stringify(baseConhecimentoPadrao));
      }

      function adicionarMensagemIaChat(remetente, mensagem) {
          const chatBox = document.getElementById('iaChatBox');
          if (!chatBox) return;
          
          const spanRemetente = document.createElement('div');
          spanRemetente.style.fontWeight = 'bold';
          spanRemetente.style.marginBottom = '2px';

          if (remetente.indexOf("IA") !== -1) {
              spanRemetente.style.color = '#38bdf8';
              spanRemetente.textContent = remetente + ':';
          } else {
              spanRemetente.style.color = '#4ade80';
              spanRemetente.textContent = remetente + ':';
          }

          const divMsg = document.createElement('div');
          divMsg.style.color = 'var(--text-primary)';
          divMsg.style.marginBottom = '12px';
          divMsg.style.whiteSpace = 'pre-wrap';
          divMsg.textContent = mensagem;

          chatBox.appendChild(spanRemetente);
          chatBox.appendChild(divMsg);
          chatBox.scrollTop = chatBox.scrollHeight;
      }

      function carregarBoasVindasIa() {
          inicializarBaseConhecimento();
          const chatBox = document.getElementById('iaChatBox');
          if (chatBox) {
              chatBox.innerHTML = '';
              adicionarMensagemIaChat("🤖 Assistente IA", "Olá! Estou pronto para auxiliar nos atendimentos. Digite sua dúvida sobre PID, senhas, cartões bloqueados ou procedimentos.");
          }
      }

      function normalizarTexto(texto) {
          if (!texto) return '';
          return texto.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
      }

      function buscarRespostaNaBase(termoBusca) {
          if (typeof baseConhecimentoPadrao !== 'undefined') {
              localStorage.setItem('brblog_base_conhecimento', JSON.stringify(baseConhecimentoPadrao));
          }

          let base = JSON.parse(localStorage.getItem('brblog_base_conhecimento') || '[]');
          if (base.length === 0 && typeof baseConhecimentoPadrao !== 'undefined') {
              base = baseConhecimentoPadrao;
          }

          let buscaNorm = normalizarTexto(termoBusca);
          if (!buscaNorm) return null;

          let palavrasBusca = buscaNorm.split(/\s+/).filter(Boolean);
          if (palavrasBusca.length === 0) return null;

          let resultados = [];
          base.forEach(function(linha) {
              if (!linha || linha.indexOf('|') === -1) return;
              let partes = linha.split('|');
              let perguntaBase = partes[0].trim();
              let respostaBase = partes[1].trim();

              let linhaCompleta = normalizarTexto(perguntaBase + " " + respostaBase);
              let atendeTodas = palavrasBusca.every(palavra => linhaCompleta.indexOf(palavra) !== -1);

              if (atendeTodas) {
                  resultados.push("📌 **" + perguntaBase + "**\n" + respostaBase);
              }
          });

          if (resultados.length > 0) {
              return resultados.slice(0, 60).join("\n\n----------------------------------------\n\n");
          }
          return null;
      }

      function processarEnvioIa() {
          const txt = document.getElementById('iaTxtPergunta');
          if (!txt) return;
          const pergunta = txt.value.trim();
          if (!pergunta) return;

          adicionarMensagemIaChat("👤 Você", pergunta);
          txt.value = '';

          let resposta = buscarRespostaNaBase(pergunta);
          if (resposta) {
              adicionarMensagemIaChat("🤖 Assistente IA", resposta);
          } else {
              adicionarMensagemIaChat("🤖 Assistente IA", "Não encontrei uma diretriz exata para isso na base atual. Clique em 'Ensinar IA' para adicionar!");
          }
          txt.focus();
      }

      segurarEvento('iaBtnEnviar', 'click', processarEnvioIa);
      segurarEvento('iaTxtPergunta', 'keydown', function(e) {
          if (e.key === 'Enter') {
              e.preventDefault();
              processarEnvioIa();
          }
      });

      segurarEvento('iaBtnAprender', 'click', function() {
          let novaPergunta = prompt("Digite a pergunta ou dúvida que deseja cadastrar:");
          if (!novaPergunta || !novaPergunta.trim()) return;

          let novaResposta = prompt("Digite a resposta correta para:\n\"" + novaPergunta + "\"");
          if (!novaResposta || !novaResposta.trim()) return;

          let base = JSON.parse(localStorage.getItem('brblog_base_conhecimento') || '[]');
          base.push(novaPergunta.trim() + "|" + novaResposta.trim());
          localStorage.setItem('brblog_base_conhecimento', JSON.stringify(base));

          adicionarMensagemIaChat("🤖 Assistente IA", "Aprendizado salvo com sucesso!");
          const txtPerg = document.getElementById('iaTxtPergunta');
          if (txtPerg) txtPerg.focus();
      });

      // --- FORMULÁRIO DE NOVO ATENDIMENTO ---
      const opcoesPidOriginal = [
          "",
          "RG/CNH",
          "Possui um adicional? (Sim ou Não)",
          "Data do Vencimento da Fatura",
          "Valor da Ultima Compra (Valor Exato)",
          "Valor da Ultima Fatura (Valor Exato)",
          "Puro Crédito / Múltiplo"
      ];

      let atualizandoCombos = false;

      const templateTexto = 
      '--------------------------------------------------\n' +
      'Inicio do Log\n' +
      '--------------------------------------------------\n' +
      'Cabeçalho do Log:\n' +
      'Dados do PID:\n' +
      'CPF: [PlaceHolderCPF]\n' +
      'Nome Completo: [PlaceHolderNome]\n' +
      'Bandeira: [PlaceHolderBandeira]\n' +
      'Últimos 4 Dígitos: [PlaceHolderUltimos]\n' +
      'Telefone de Cadastro: [PlaceHolderTelCadastro]\n' +
      'Telefone de Contato: [PlaceHolderTelContato]\n\n' +
      '[PlaceHolderPid1]: [PlaceHolderRespostaPid1]\n' +
      '[PlaceHolderPid2]: [PlaceHolderRespostaPid2]\n\n' +
      'Dados do Atendimento:\n' +
      'Cliente: [PlaceHolderNomeAtendimento] entrou em contato informando que: [PlaceHolderMotivo]\n\n' +
      'Tratativa realizada: [PlaceHolderTratativa]\n' +
      '--------------------------------------------------\n' +
      'Fim do Log\n' +
      '--------------------------------------------------';

      function carregarOpcoesPid() {
          const cb1 = document.getElementById('cbxPid1');
          const cb2 = document.getElementById('cbxPid2');
          if (!cb1 || !cb2) return;
          cb1.innerHTML = ''; cb2.innerHTML = '';
          opcoesPidOriginal.forEach(function(op) {
              cb1.appendChild(new Option(op, op));
              cb2.appendChild(new Option(op, op));
          });

          cb1.value = "";
          cb2.value = "";
          handlePidChange(1);
      }

      function handlePidChange(origem) {
          if (atualizandoCombos) return;
          atualizandoCombos = true;
          const cb1 = document.getElementById('cbxPid1');
          const cb2 = document.getElementById('cbxPid2');
          if (!cb1 || !cb2) {
              atualizandoCombos = false;
              return;
          }
          const val1 = cb1.value; const val2 = cb2.value;

          if (origem === 1) {
              const opcoesFiltradas = opcoesPidOriginal.filter(function(op) {
                  return op === "" || op !== val1;
              });
              cb2.innerHTML = '';
              opcoesFiltradas.forEach(function(op) {
                  cb2.appendChild(new Option(op, op));
              });
              if (opcoesFiltradas.includes(val2)) cb2.value = val2;
          } else {
              const opcoesFiltradas = opcoesPidOriginal.filter(function(op) {
                  return op === "" || op !== val2;
              });
              cb1.innerHTML = '';
              opcoesFiltradas.forEach(function(op) {
                  cb1.appendChild(new Option(op, op));
              });
              if (opcoesFiltradas.includes(val1)) cb1.value = val1;
          }
          atualizandoCombos = false;
          atualizarPreVisualizacao();
      }

      function validarCPF(cpf) {
          cpf = cpf.replace(/[^\d]/g, '');
          if (cpf.length !== 11 || /^(\d)\1{10}$/.test(cpf)) return false;
          let soma = 0;
          for (let i = 0; i < 9; i++) soma += parseInt(cpf.charAt(i)) * (10 - i);
          let resto = 11 - (soma % 11);
          if (resto === 10 || resto === 11) resto = 0;
          if (resto !== parseInt(cpf.charAt(9))) return false;
          soma = 0;
          for (let i = 0; i < 10; i++) soma += parseInt(cpf.charAt(i)) * (11 - i);
          resto = 11 - (soma % 11);
          if (resto === 10 || resto === 11) resto = 0;
          if (resto !== parseInt(cpf.charAt(10))) return false;
          return true;
      }

      function aplicarMascaraCPF(e) {
          let v = e.target.value.replace(/\D/g, '');
          if (v.length > 11) v = v.slice(0, 11);
          if (v.length > 9) v = v.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/, "$1.$2.$3-$4");
          else if (v.length > 6) v = v.replace(/^(\d{3})(\d{3})(\d{1,3})$/, "$1.$2.$3");
          else if (v.length > 3) v = v.replace(/^(\d{3})(\d{1,3})$/, "$1.$2");
          e.target.value = v;

          const lbl = document.getElementById('lblValidaCPF');
          if (v.length === 14) {
              if (validarCPF(v)) {
                  e.target.style.backgroundColor = '#d4edda';
                  if (lbl) {
                      lbl.style.color = 'green';
                      lbl.textContent = 'CPF Válido';
                  }
              } else {
                  e.target.style.backgroundColor = '#f8d7da';
                  if (lbl) {
                      lbl.style.color = 'red';
                      lbl.textContent = 'CPF Inválido';
                  }
              }
          } else {
              e.target.style.backgroundColor = '#ffffff';
              if (lbl) lbl.textContent = '';
          }
          atualizarPreVisualizacao();
      }

      function aplicarMascaraTelefone(e) {
          let v = e.target.value.replace(/\D/g, '');
          if (v.length > 11) v = v.slice(0, 11);
          if (v.length > 10) v = v.replace(/^(\d{2})(\d{5})(\d{4})$/, "($1) $2-$3");
          else if (v.length > 6) v = v.replace(/^(\d{2})(\d{4})(\d{0,4})$/, "($1) $2-$3");
          else if (v.length > 2) v = v.replace(/^(\d{2})(\d{0,5})$/, "($1) $2");
          else if (v.length > 0) v = v.replace(/^(\d{0,2})$/, "($1");
          e.target.value = v;
          atualizarPreVisualizacao();
      }

      function atualizarPreVisualizacao() {
          const previewBox = document.getElementById('previewBox');
          if (!previewBox) return;

          let texto = templateTexto;
          const txtCpf = document.getElementById('txtCPF');
          const txtNome = document.getElementById('txtNome');
          const cbBandeira = document.getElementById('cbxBandeira');
          const txtUltimos = document.getElementById('txtUltimos4');
          const txtTelCad = document.getElementById('txtTelCadastro');
          const rdbSim = document.getElementById('rdbSim');
          const txtTelCont = document.getElementById('txtTelContato');
          const cbPid1 = document.getElementById('cbxPid1');
          const txtResp1 = document.getElementById('txtRespPid1');
          const cbPid2 = document.getElementById('cbxPid2');
          const txtResp2 = document.getElementById('txtRespPid2');
          const txtMot = document.getElementById('txtMotivo');
          const txtTrat = document.getElementById('txtTratativa');

          const cpf = txtCpf ? txtCpf.value : '';
          const nome = txtNome ? txtNome.value : '';
          const bandeira = cbBandeira ? cbBandeira.value : '';
          const ultimos = txtUltimos ? txtUltimos.value : '';
          const telCad = txtTelCad ? txtTelCad.value : '';
          const simChecked = rdbSim ? rdbSim.checked : true;
          const telCont = simChecked ? telCad : (txtTelCont ? txtTelCont.value : '');
          const pid1 = cbPid1 ? cbPid1.value : '';
          const resp1 = txtResp1 ? txtResp1.value : '';
          const pid2 = cbPid2 ? cbPid2.value : '';
          const resp2 = txtResp2 ? txtResp2.value : '';
          const motivo = txtMot ? txtMot.value : '';
          const tratativa = txtTrat ? txtTrat.value : '';
         
          const nomeAtendimento = nome ? nome : 'Cliente';

          texto = texto.replace('[PlaceHolderCPF]', cpf);
          texto = texto.replace('[PlaceHolderNome]', nome);
          texto = texto.replace('[PlaceHolderNomeAtendimento]', nomeAtendimento); 
          texto = texto.replace('[PlaceHolderBandeira]', bandeira);
          texto = texto.replace('[PlaceHolderUltimos]', ultimos);
          texto = texto.replace('[PlaceHolderTelCadastro]', telCad);
          texto = texto.replace('[PlaceHolderTelContato]', telCont);
          texto = texto.replace('[PlaceHolderPid1]', pid1 || 'PID Opcional 1');
          texto = texto.replace('[PlaceHolderRespostaPid1]', resp1);
          texto = texto.replace('[PlaceHolderPid2]', pid2 || 'PID Opcional 2');
          texto = texto.replace('[PlaceHolderRespostaPid2]', resp2);
          texto = texto.replace('[PlaceHolderMotivo]', motivo);
          texto = texto.replace('[PlaceHolderTratativa]', tratativa);

          previewBox.textContent = texto;
      }

      segurarEvento('rdbSim', 'change', function() {
          const divContato = document.getElementById('divTelContato');
          const boxRestr = document.getElementById('boxRestricoes');
          const txtCont = document.getElementById('txtTelContato');
          if (divContato) divContato.style.display = 'none';
          if (boxRestr) boxRestr.style.display = 'none';
          if (txtCont) txtCont.value = '';
          atualizarPreVisualizacao();
      });

      segurarEvento('rdbNao', 'change', function() {
          const divContato = document.getElementById('divTelContato');
          const boxRestr = document.getElementById('boxRestricoes');
          const txtCont = document.getElementById('txtTelContato');
          if (divContato) divContato.style.display = 'block';
          if (boxRestr) boxRestr.style.display = 'block';
          if (txtCont) txtCont.focus();
          atualizarPreVisualizacao();
      });

      segurarEvento('txtCPF', 'input', aplicarMascaraCPF);
      segurarEvento('txtTelCadastro', 'input', aplicarMascaraTelefone);
      segurarEvento('txtTelContato', 'input', aplicarMascaraTelefone);
      segurarEvento('txtNome', 'input', atualizarPreVisualizacao);
      segurarEvento('cbxBandeira', 'change', atualizarPreVisualizacao);
      segurarEvento('txtUltimos4', 'input', atualizarPreVisualizacao);
      segurarEvento('cbxPid1', 'change', function() { handlePidChange(1); });
      segurarEvento('cbxPid2', 'change', function() { handlePidChange(2); });
      segurarEvento('txtRespPid1', 'input', atualizarPreVisualizacao);
      segurarEvento('txtRespPid2', 'input', atualizarPreVisualizacao);
      segurarEvento('txtMotivo', 'input', atualizarPreVisualizacao);
      segurarEvento('txtTratativa', 'input', atualizarPreVisualizacao);

      segurarEvento('btnCopiarCpf', 'click', function() {
          const txtCpf = document.getElementById('txtCPF');
          if (txtCpf && txtCpf.value) navigator.clipboard.writeText(txtCpf.value);
      });

      // --- FUNÇÃO DE VALIDAÇÃO UNIFICADA ---
      function validarFormulario() {
          const txtCpf = document.getElementById('txtCPF');
          const txtNome = document.getElementById('txtNome');
          const cbBandeira = document.getElementById('cbxBandeira');
          const txtUltimos4 = document.getElementById('txtUltimos4');
          const txtTelCad = document.getElementById('txtTelCadastro');
          const rdbSim = document.getElementById('rdbSim');
          const txtTelCont = document.getElementById('txtTelContato');
          const cbPid1 = document.getElementById('cbxPid1');
          const txtResp1 = document.getElementById('txtRespPid1');
          const cbPid2 = document.getElementById('cbxPid2');
          const txtResp2 = document.getElementById('txtRespPid2');
          const txtMot = document.getElementById('txtMotivo');
          const txtTrat = document.getElementById('txtTratativa');

          const cpf = txtCpf ? txtCpf.value.trim() : '';
          const nome = txtNome ? txtNome.value.trim() : '';
          const bandeira = cbBandeira ? cbBandeira.value : '';
          const ultimos4 = txtUltimos4 ? txtUltimos4.value.trim() : '';
          const telCad = txtTelCad ? txtTelCad.value.trim() : '';
          const simChecked = rdbSim ? rdbSim.checked : true;
          const telCont = txtTelCont ? txtTelCont.value.trim() : '';
          const pid1Sel = cbPid1 ? cbPid1.value : '';
          const resp1 = txtResp1 ? txtResp1.value.trim() : '';
          const pid2Sel = cbPid2 ? cbPid2.value : '';
          const resp2 = txtResp2 ? txtResp2.value.trim() : '';
          const motivo = txtMot ? txtMot.value.trim() : '';
          const tratativa = txtTrat ? txtTrat.value.trim() : '';

          let camposFaltando = [];

          if (!cpf) camposFaltando.push("CPF");
          if (!nome) camposFaltando.push("Nome Completo");
          if (!bandeira || bandeira === "Selecione...") camposFaltando.push("Bandeira");
          if (!ultimos4) camposFaltando.push("Últimos 4 Dígitos do Cartão");
          if (!telCad) camposFaltando.push("Telefone de Cadastro");
          
          if (!simChecked && !telCont) {
              camposFaltando.push("Telefone de Contato");
          }

          if (!pid1Sel || !resp1) camposFaltando.push("PID Opcional 1 (Seleção e Resposta)");
          if (!pid2Sel || !resp2) camposFaltando.push("PID Opcional 2 (Seleção e Resposta)");
          if (!motivo) camposFaltando.push("Motivo do Contato");
          if (!tratativa) camposFaltando.push("Tratativa Realizada (Resolução)");

          if (camposFaltando.length > 0) {
              alert("Por favor, preencha os seguintes campos obrigatórios:\n\n• " + camposFaltando.join("\n• "));
              return false;
          }
          return true;
      }

      segurarEvento('btnSalvar', 'click', function() {
          if (!validarFormulario()) return;

          const txtCpf = document.getElementById('txtCPF');
          const txtNome = document.getElementById('txtNome');
          const cbBandeira = document.getElementById('cbxBandeira');
          const previewBox = document.getElementById('previewBox');

          const cpf = txtCpf ? txtCpf.value.trim() : '';
          const nome = txtNome ? txtNome.value.trim() : '';
          const bandeira = cbBandeira ? cbBandeira.value : '';
          const logTextoFormatado = previewBox ? previewBox.textContent : '';

          const novoAtendimento = {
              id: Date.now().toString().slice(-4),
              dataHora: new Date().toLocaleString('pt-BR'),
              cpf: cpf, 
              nome: nome, 
              bandeira: bandeira,
              logCompleto: logTextoFormatado
          };

          const atendimentos = JSON.parse(localStorage.getItem('brblog_atendimentos') || '[]');
          atendimentos.push(novoAtendimento);
          localStorage.setItem('brblog_atendimentos', JSON.stringify(atendimentos));

          alert('Atendimento salvo com sucesso!');
          
          const inputs = document.querySelectorAll('input:not([type="radio"]), textarea');
          inputs.forEach(function(el) { el.value = ''; });
          if (cbBandeira) cbBandeira.selectedIndex = 0;
          const rdbSim = document.getElementById('rdbSim');
          if (rdbSim) rdbSim.checked = true;
          
          const divContato = document.getElementById('divTelContato');
          const boxRestr = document.getElementById('boxRestricoes');
          if (divContato) divContato.style.display = 'none';
          if (boxRestr) boxRestr.style.display = 'none';
          if (txtCpf) txtCpf.style.backgroundColor = '#ffffff';

          carregarOpcoesPid();
          atualizarPreVisualizacao();

          ocultarTodasViews();
          if (viewDashboard) viewDashboard.classList.add('active');
          carregarAtendimentosHoje();
      });

      segurarEvento('btnCopiarLogForm', 'click', function() {
          const previewBox = document.getElementById('previewBox');
          if (previewBox) {
              const textoLog = previewBox.textContent;
              navigator.clipboard.writeText(textoLog).then(function() {
                  alert('Log copiado para a área de transferência!');
              });
          }
      });

      segurarEvento('btnLimpar', 'click', function() {
          if (confirm('Deseja realmente limpar todos os campos do atendimento?')) {
              const inputs = document.querySelectorAll('input:not([type="radio"]), textarea');
              inputs.forEach(function(el) { el.value = ''; });
              const cbBandeira = document.getElementById('cbxBandeira');
              if (cbBandeira) cbBandeira.selectedIndex = 0;
              const rdbSim = document.getElementById('rdbSim');
              if (rdbSim) rdbSim.checked = true;
              
              const divContato = document.getElementById('divTelContato');
              const boxRestr = document.getElementById('boxRestricoes');
              if (divContato) divContato.style.display = 'none';
              if (boxRestr) boxRestr.style.display = 'none';
              const txtCpf = document.getElementById('txtCPF');
              if (txtCpf) {
                  txtCpf.style.backgroundColor = '#ffffff';
                  txtCpf.focus();
              }
              carregarOpcoesPid();
              atualizarPreVisualizacao();
          }
      });

      // --- DASHBOARD ---
      function carregarAtendimentosHoje() {
          const tbody = document.getElementById('tblCorpo');
          const lblContador = document.getElementById('lblContador');
          if (!tbody) return;
          
          const atendimentos = JSON.parse(localStorage.getItem('brblog_atendimentos') || '[]');
          const hoje = new Date().toLocaleDateString('pt-BR');
          
          const atendimentosHoje = atendimentos.filter(function(a) {
              return a.dataHora && a.dataHora.startsWith(hoje);
          });
          let atendimentosCache = atendimentosHoje.slice().reverse();

          if (lblContador) {
              lblContador.textContent = 'Atendimentos realizados hoje: ' + atendimentosHoje.length;
          }

          if (atendimentosCache.length === 0) {
              tbody.innerHTML = '<tr><td colspan="5" class="empty-row">Nenhum atendimento registrado hoje.</td></tr>';
              return;
          }

          tbody.innerHTML = '';
          atendimentosCache.forEach(function(item, index) {
              const tr = document.createElement('tr');
              tr.innerHTML = '<td>' + (item.id || (index + 1)) + '</td>' +
                  '<td>' + (item.dataHora || '') + '</td>' +
                  '<td>' + (item.cpf || '') + '</td>' +
                  '<td>' + (item.nome || '') + '</td>' +
                  '<td>' + (item.bandeira || '') + '</td>';
              tr.addEventListener('dblclick', function() {
                  abrirDetalhesAtendimento(item);
              });
              tbody.appendChild(tr);
          });
      }

      function abrirDetalhesAtendimento(item) {
          const modal = document.getElementById('modalDetalhes');
          const conteudoLog = document.getElementById('modalConteudoLog');
          if (conteudoLog) conteudoLog.textContent = item.logCompleto || 'Log indisponível.';
          if (modal) modal.style.display = 'flex';
      }

      function fecharModal() {
          const modal = document.getElementById('modalDetalhes');
          if (modal) modal.style.display = 'none';
      }

      segurarEvento('btnCloseModal', 'click', fecharModal);
      segurarEvento('btnModalFechar', 'click', fecharModal);
      segurarEvento('btnModalCopiar', 'click', function() {
          const conteudoLog = document.getElementById('modalConteudoLog');
          if (conteudoLog) {
              const texto = conteudoLog.textContent;
              navigator.clipboard.writeText(texto).then(function() {
                  alert('Log copiado para a área de transferência!');
              });
          }
      });

      window.addEventListener('click', function(e) {
          const modal = document.getElementById('modalDetalhes');
          if (e.target === modal) fecharModal();
      });

      segurarEvento('menuAtualizarLista', 'click', function() {
          carregarAtendimentosHoje();
      });

      segurarEvento('menuLimparBase', 'click', function() {
          if (confirm('Deseja realmente limpar a base de dados local de hoje?')) {
              localStorage.removeItem('brblog_atendimentos');
              carregarAtendimentosHoje();
          }
      });

      // --- LÓGICA DE FEEDBACK / BUG ---
      segurarEvento('menuFeedback', 'click', function() {
          const modal = document.getElementById('modalFeedback');
          if (modal) modal.style.display = 'flex';
      });

      segurarEvento('btnCopiarEmail', 'click', function() {
          const emailInput = document.getElementById('txtEmailFeedback');
          if (emailInput) {
              navigator.clipboard.writeText(emailInput.value).then(function() {
                  alert('E-mail copiado para a área de transferência!');
              }).catch(function(err) {
                  console.error('Erro ao copiar e-mail: ', err);
              });
          }
      });

      function fecharModalFeedback() {
          const modal = document.getElementById('modalFeedback');
          if (modal) modal.style.display = 'none';
      }

      segurarEvento('btnFecharFeedback', 'click', fecharModalFeedback);
      segurarEvento('btnCloseFeedback', 'click', fecharModalFeedback);

      window.addEventListener('click', function(e) {
          const modal = document.getElementById('modalFeedback');
          if (e.target === modal) {
              fecharModalFeedback();
          }
      });

      function alternarDarkMode() {
          document.body.classList.toggle('dark-mode');
          const estaEscuro = document.body.classList.contains('dark-mode');
          localStorage.setItem('brblog_dark_mode', estaEscuro ? 'ativo' : 'inativo');
      }

      window.addEventListener('DOMContentLoaded', function() {
          const preferenciaSalva = localStorage.getItem('brblog_dark_mode');
          if (preferenciaSalva === 'ativo') {
              document.body.classList.add('dark-mode');
          }
      });

      // Atalhos globais
      window.addEventListener('keydown', function(event) {
          if (event.ctrlKey && event.altKey && event.key.toLowerCase() === 'd') {
              event.preventDefault();
              alternarDarkMode();
          }
      });

      window.addEventListener('keydown', function(event) {
          if (event.ctrlKey && event.altKey && event.key.toLowerCase() === 'a') {
              event.preventDefault();
              const btnNovoAtendimento = document.querySelector('#menuNovoAtendimento') || 
                  Array.from(document.querySelectorAll('button')).find(el => el.textContent.includes('Novo Atendimento'));
              if (btnNovoAtendimento) {
                  btnNovoAtendimento.click();
              }
          }
      });

      window.addEventListener('keydown', function(event) {
          if (event.ctrlKey && event.altKey && event.key.toLowerCase() === 'i') {
              event.preventDefault();
              const btnIA = document.querySelector('#menuIA') || 
                  Array.from(document.querySelectorAll('button')).find(el => el.textContent.includes('IA de Apoio'));
              if (btnIA) {
                  btnIA.click();
              }
          }
      });

      window.addEventListener('keydown', function(event) {
          if (event.ctrlKey && event.altKey && event.key.toLowerCase() === 'f') {
              event.preventDefault();
              const btnConsultar = document.querySelector('#menuConsultarHistorico') || 
                  Array.from(document.querySelectorAll('button')).find(el => el.textContent.includes('Consultar Histórico'));
              if (btnConsultar) {
                  btnConsultar.click();
              }
          }
      });

      window.addEventListener('keydown', function(event) {
          const tecla = event.key.toLowerCase();
          
          if (event.ctrlKey && event.altKey && tecla === 's') {
              event.preventDefault();
              
              if (!validarFormulario()) return;

              const btnSalvar = document.getElementById('btnSalvar') || 
                  Array.from(document.querySelectorAll('button')).find(el => el.textContent.includes('Salvar'));
              if (btnSalvar) {
                  btnSalvar.click();
              }
          }
          
          else if (!event.ctrlKey && event.altKey && tecla === 'c') {
              event.preventDefault();
              
              if (!validarFormulario()) return;

              const btnCopiar = document.getElementById('btnCopiarLogForm') || 
                  Array.from(document.querySelectorAll('button')).find(el => el.textContent.includes('Copiar Log'));
              if (btnCopiar) {
                  btnCopiar.click();
              }
          }
      });

      // --- INICIALIZAÇÃO ---
      carregarOpcoesPid();
      atualizarPreVisualizacao();
      carregarAtendimentosHoje();
      carregarBoasVindasIa();
    </script>
  </body>
</html>